{
    "name": "twitch-automod-server",
    "version": "1.0.0",
    "description": "Backend for Twitch Auto-Moderator",
    "main": "dist/server.cjs",
    "scripts": {
        "start": "node dist/server.cjs",
        "dev": "ts-node src/server.ts",
        "typecheck": "tsc --noEmit",
        "build": "tsc --noEmit && node bundle.mjs",
        "package": "pkg dist/server.cjs --config package.json --output dist/TwitchWatcher.exe"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "dependencies": {
        "@google/generative-ai": "^0.24.1",
        "axios": "^0.27.2",
        "cors": "^2.8.5",
        "express": "^4.18.2",
        "ollama": "^0.5.0",
        "open": "^8.4.2",
        "png-to-ico": "^3.0.1",
        "resedit": "^3.0.1",
        "tiktok-live-connector": "^2.5.0",
        "tmi.js": "^1.8.5",
        "youtubei.js": "^18.0.0"
    },
    "devDependencies": {
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.21",
        "@types/node": "^20.10.6",
        "@types/tmi.js": "^1.8.6",
        "@yao-pkg/pkg": "^6.22.0",
        "esbuild": "^0.28.2",
        "ts-node": "^10.9.2",
        "typescript": "^5.3.3"
    },
    "bin": "dist/server.cjs",
    "pkg": {
        "assets": [
            "public/**/*"
        ],
        "targets": [
            "node22-win-x64"
        ]
    },
    "engines": {
        "node": ">=20.0.0"
    }
}
